# OpenAI API key for LLM-assisted rules (R002, R003, R004, R005, R006, R007)
OPENAI_API_KEY=sk-...

# Model selection per agent.
# COMPLIANCE_AUDITOR_MODEL and DEMAND_SMITH_MODEL use bare model names (e.g. gpt-4o-mini)
# because they call agents/shared/llm_client.py → ChatOpenAI, which expects no prefix.
# RECOVERY_ORACLE_MODEL uses the openai: prefix because RecoveryOracle uses Pydantic AI's
# native model layer, which requires the provider prefix (openai:gpt-4o-mini).
COMPLIANCE_AUDITOR_MODEL=gpt-4o-mini
RECOVERY_ORACLE_MODEL=openai:gpt-4o-mini

# Reserved for DemandSmith (Stage 3 letter drafter)
# DEMAND_SMITH_MODEL=gpt-4o-mini

# Logging level
LOG_LEVEL=INFO
