# OpenAI API key for LLM-assisted rules (R002, R003, R004, R005, R006, R007)
OPENAI_API_KEY=sk-...

# Model selection per agent. Defaults if unset: openai:gpt-4o-mini
COMPLIANCE_AUDITOR_MODEL=openai:gpt-4o-mini
RECOVERY_ORACLE_MODEL=openai:gpt-4o-mini

# Reserved for DemandSmith (Stage 3 letter drafter)
# DEMAND_SMITH_MODEL=openai:gpt-4o-mini

# Logging level
LOG_LEVEL=INFO
