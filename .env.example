# OpenAI API key for LLM-assisted rules (R002, R003, R004, R005, R006, R007)
OPENAI_API_KEY=sk-...

# Model selection per agent. Defaults if unset: openai:gpt-4o-mini for Pydantic AI agents,
# gpt-4o-mini (no prefix) for LangChain agents.
COMPLIANCE_AUDITOR_MODEL=gpt-4o-mini
RECOVERY_ORACLE_MODEL=openai:gpt-4o-mini
DEMAND_SMITH_MODEL=gpt-4o-mini
PAPER_TRAIL_MODEL=gpt-4o-mini

# NOTE: RECOVERY_ORACLE_MODEL uses Pydantic AI's "openai:" prefix format.
# The other three use LangChain's bare format (no prefix).

# Logging level
LOG_LEVEL=INFO
