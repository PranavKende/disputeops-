{
  "document": {
    "dsl": "1.0.0",
    "name": "CarrierBridge",
    "version": "0.0.1",
    "namespace": "default",
    "metadata": {
      "variables": {
        "schema": {
          "format": "json",
          "document": {
            "type": "object",
            "properties": {},
            "title": "Variables"
          }
        }
      }
    }
  },
  "input": {
    "schema": {
      "format": "json",
      "document": {
        "type": "object",
        "properties": {
          "case_id":          { "type": "string" },
          "container_number": { "type": "string" },
          "evidence_gate":    { "type": "object" }
        },
        "title": "Inputs"
      }
    }
  },
  "output": {
    "schema": {
      "format": "json",
      "document": {
        "type": "object",
        "properties": {
          "evidence_data": { "type": "object" }
        },
        "title": "Outputs"
      }
    }
  },
  "do": [
    {
      "Sequence_1": {
        "do": [
          {
            "WorkflowStart": {
              "set": "${Object.entries($workflow.definition?.document?.metadata?.variables?.schema?.document?.properties || {}).reduce((acc, [name, def]) => ({ ...acc, [name]: def?.default }), {}) }",
              "output": { "as": "${$input}" },
              "export": { "as": "{ ...$context, variables: { ...$context.variables, ...$output } }" },
              "metadata": { "activityType": "Assign", "displayName": "Workflow start", "fullName": "Assign", "isTransparent": true }
            }
          },
          {
            "Javascript_BuildEvidenceData": {
              "run": {
                "script": {
                  "language": "javascript",
                  "arguments": "${{ \"$context\": $context, \"$workflow\": $workflow, \"$input\": $input }}",
                  "code": "const gate = $workflow.input.evidence_gate || {};\nreturn {\n  case_id: $workflow.input.case_id,\n  container_number: $workflow.input.container_number,\n  gate_in_timestamp:  gate.gate_in_timestamp  || null,\n  gate_out_timestamp: gate.gate_out_timestamp || null,\n  weather_events:     gate.weather_events     || [],\n  terminal_records:   gate.terminal_records   || [],\n  bol_terms: 'Free Time expires 4 business days after container availability; demurrage accrues at $185/day thereafter until empty container is returned to terminal gate.',\n  carrier_tariff_reference: 'Maersk Line Tariff Rule 9.2 (NAEC Demurrage & Detention Schedule, effective 2025-01-15).',\n  published_free_time_days: 4,\n  shipper_name: 'ABC Trading Co., Ltd. (Foshan, CN)',\n  notice_of_availability_date: '2026-05-04T16:20:00Z',\n  source: 'DEMO_STAND_IN',\n  note: 'In production: call the carrier API (Maersk Spot, CMA CGM eBusiness, etc.) to fetch published tariff and bill of lading terms. Hard-coded here so the case flows end-to-end without a real integration.'\n};"
                }
              },
              "export": { "as": "{ ...$context, outputs: { ...$context?.outputs, \"Javascript_BuildEvidenceData\": $output } }" },
              "metadata": { "activityType": "JsInvoke", "displayName": "Build evidence_data from gate + carrier", "fullName": "JsInvoke" }
            }
          },
          {
            "Response_1": {
              "response": "${{ evidence_data: $context.outputs.Javascript_BuildEvidenceData, status: 'success' }}",
              "markJobAsFailed": false,
              "then": "end",
              "export": { "as": "{ ...$context, outputs: { ...$context?.outputs, \"Response_1\": $output } }" },
              "metadata": { "activityType": "Response", "displayName": "Response", "fullName": "Response" }
            }
          }
        ],
        "metadata": { "activityType": "Sequence", "displayName": "Main Sequence", "fullName": "Sequence" }
      }
    }
  ],
  "evaluate": { "mode": "strict", "language": "javascript" }
}
