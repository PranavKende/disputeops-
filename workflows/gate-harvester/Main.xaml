  <!--
    GateHarvester — DEMO STAND-IN for production TMS scraper.
    In production: scrapes gate-in / gate-out timestamps from a TMS portal (Container terminal gate movement log).
    Here: returns hard-coded demo evidence so the case can flow end-to-end without a real integration.
    TODO[production]: replace Assign bodies with real HTTP/UIA calls to the TMS portal.
  -->
  <x:Members>
    <x:Property Name="in_case_id" Type="InArgument(x:String)" />
    <x:Property Name="in_container_number" Type="InArgument(x:String)" />
    <x:Property Name="out_gate_in_timestamp" Type="OutArgument(x:String)" />
    <x:Property Name="out_gate_out_timestamp" Type="OutArgument(x:String)" />
    <x:Property Name="out_weather_events" Type="OutArgument(scg:List(x:String))" />
    <x:Property Name="out_terminal_records" Type="OutArgument(scg:List(scg:Dictionary(x:String, x:Object)))" />
  </x:Members>
  <Sequence DisplayName="Main Sequence" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Assign DisplayName="Set gate_in_timestamp" sap2010:WorkflowViewState.IdRef="Assign_1">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">
          <CSharpReference x:TypeArguments="x:String">out_gate_in_timestamp</CSharpReference>
        </OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">"2026-05-07T07:56:00Z"</InArgument>
      </Assign.Value>
    </Assign>
    <Assign DisplayName="Set gate_out_timestamp" sap2010:WorkflowViewState.IdRef="Assign_2">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">
