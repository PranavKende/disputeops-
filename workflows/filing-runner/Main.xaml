  <!--
    FilingRunner — DEMO STAND-IN for production FMC portal submitter.
    In production: posts the dispute submission package (in_letter_data) to the Federal Maritime Commission portal and returns the FMC filing receipt id and submission timestamp.
    Here: returns a deterministic, audit-able filing reference derived from the case id and the run timestamp, so the case flow ends with a real (non-empty) receipt.
    TODO[production]: replace Assign bodies with real HTTP POST to https://fmc.gov/submit-dispute and read the receipt id from the response body.
  -->
  <x:Members>
    <x:Property Name="in_case_id" Type="InArgument(x:String)" />
    <x:Property Name="in_container_number" Type="InArgument(x:String)" />
    <x:Property Name="in_letter_data" Type="InArgument(x:String)" />
    <x:Property Name="out_filing_reference" Type="OutArgument(x:String)" />
    <x:Property Name="out_filing_timestamp" Type="OutArgument(x:String)" />
  </x:Members>
  <Sequence DisplayName="Main Sequence" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Assign DisplayName="Set filing timestamp (UTC, ISO 8601)" sap2010:WorkflowViewState.IdRef="Assign_1">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">
          <CSharpReference x:TypeArguments="x:String">out_filing_timestamp</CSharpReference>
        </OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">
          <CSharpValue x:TypeArguments="x:String">DateTime.UtcNow.ToString("o")</CSharpValue>
        </InArgument>
      </Assign.Value>
    </Assign>
    <Assign DisplayName="Set filing reference (FMC + case id + UTC timestamp)" sap2010:WorkflowViewState.IdRef="Assign_2">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">
          <CSharpReference x:TypeArguments="x:String">out_filing_reference</CSharpReference>
        </OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">
          <CSharpValue x:TypeArguments="x:String">"FMC-" + (in_case_id ?? "UNKNOWN") + "-" + DateTime.UtcNow.ToString("yyyyMMddHHmmss")</CSharpValue>
        </InArgument>
      </Assign.Value>
    </Assign>
  </Sequence>
</Activity>
