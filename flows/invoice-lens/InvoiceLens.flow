    {
      "id": "mapExtractedFields1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Map Extracted Fields"
      },
      "inputs": {
        "script": "const r = $vars.extractInvoiceFields1.output;\nconst rd = r && r.ExtractionResult && r.ExtractionResult.ResultsDocument;\nconst groups = (rd && rd.Fields) || [];\nlet comps = [];\ngroups.forEach(function(gp){ if (gp && gp.Values && gp.Values[0] && gp.Values[0].Components && gp.Values[0].Components.length) { comps = comps.concat(gp.Values[0].Components); } else if (gp) { comps.push(gp); } });\nconst val = (name) => { const f = comps.find(x => x.FieldName === name); if (!f || f.IsMissing || !f.Values || f.Values.length === 0) return \"\"; const v0 = f.Values[0]; if (v0 == null) return \"\"; return (typeof v0 === \"object\") ? (v0.Value != null ? v0.Value : \"\") : v0; };\nconst num = (name) => { const n = parseFloat(String(val(name)).replace(/[^0-9.]/g, \"\")); return isNaN(n) ? 0 : n; };\nconst invoice_data = { invoice_number: val(\"invoice_number\"), carrier_name: val(\"carrier_name\"), bol_number: val(\"bol_number\"), container_number: val(\"container_number\"), charge_type: \"\", charge_description: val(\"basis_for_charge\"), charge_incurred_date: val(\"charge_incurred_date\"), invoice_date: val(\"invoice_date\"), free_time_start: \"\", free_time_end: \"\", hours_billed: num(\"hours_billed\"), hourly_rate_usd: num(\"hourly_rate_usd\"), total_amount_usd: num(\"total_amount_usd\"), billed_to_party: val(\"billed_to_party\"), basis_for_charge: val(\"basis_for_charge\"), tariff_reference: val(\"tariff_reference\"), published_free_time_days: val(\"published_free_time_days\") };\nreturn { invoice_data: invoice_data, total_amount_usd: invoice_data.total_amount_usd };"
      }
    },
    {
      "id": "end1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      },
      "inputs": {},
      "outputs": {
        "invoice_data": {
          "source": "=js:$vars.mapExtractedFields1.output.invoice_data"
        },
        "total_amount_usd": {
          "source": "=js:$vars.mapExtractedFields1.output.total_amount_usd"
        }
      }
    }
